# Nach .env kopieren und ausfüllen. .env wird nie eingecheckt.

DISCORD_TOKEN=HIER_EINTRAGEN
DISCORD_GUILD_ID=HIER_EINTRAGEN

# Willkommensnachricht: Kanal und Nachricht, auf die reagiert wird; Emoji für die Reaktion
WELCOME_CHANNEL_ID=HIER_EINTRAGEN
WELCOME_MESSAGE_ID=HIER_EINTRAGEN
WELCOME_EMOJI=✅

# Rollen
ROLE_WHITELIST_ID=HIER_EINTRAGEN
ROLE_EINWOHNER_ID=HIER_EINTRAGEN

# Log-Kanäle (eine ID je Kategorie; leer = Kategorie wird nicht gespiegelt)
LOG_CONNECT=
LOG_CHARACTER=
LOG_MONEY=
LOG_ITEMS=
LOG_FACTION=
LOG_POLICE=
LOG_MEDIC=
LOG_JUSTICE=
LOG_CRIME=
LOG_ADMIN=
LOG_SUPPORT=

# Datenbank (dieselbe wie der Spielserver)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tacov
DB_USER=tacov
DB_PASS=HIER_EINTRAGEN

# Wie oft der Bot neue Logs aus der Tabelle liest (Sekunden)
LOG_POLL_SECONDS=5
