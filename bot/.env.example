# Nach .env kopieren und ausfüllen. .env wird nie eingecheckt.
# Kanal- und Rollen-IDs stehen in discord.json (eingecheckt), hier nur Geheimnisse.

DISCORD_TOKEN=HIER_EINTRAGEN

# Datenbank (dieselbe wie der Spielserver)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tacov
DB_USER=tacov
DB_PASS=HIER_EINTRAGEN

# Wie oft der Bot neue Logs aus der Tabelle liest (Sekunden)
LOG_POLL_SECONDS=5

# TeamSpeak-ServerQuery für das Status-Embed (setup-teamspeak.sh trägt das ein)
TS_QUERY_HOST=127.0.0.1
TS_QUERY_PORT=10011
TS_QUERY_PASS=
TS_ADDRESS=
