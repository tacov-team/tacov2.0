# TacoV – Server-Konfiguration (Vorlage)
# Nach server.cfg kopieren und ausfüllen. server.cfg wird nicht eingecheckt.
# Achtung: kein Semikolon in Kommentaren, FXServer liest alles danach als Befehl.

endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"

sv_hostname "TacoV | Deutsches Roleplay"
sets sv_projectName "TacoV"
sets sv_projectDesc "Deutscher Roleplay-Server auf FiveM"
sv_maxclients 10
sv_enforceGameBuild 3258
sv_scriptHookAllowed 0

# Lizenz von keymaster.fivem.net
sv_licenseKey "HIER_EINTRAGEN"

# Datenbank: MariaDB über die eigene Resource tacov_db, phpMyAdmin als Weboberfläche
set tacov_db "mysql://tacov:HIER_EINTRAGEN@127.0.0.1:3306/tacov"
set tacov_log_console "true"

# Discord
set tacov_discord_guild "HIER_EINTRAGEN"

# Resources: Reihenfolge regeln die Abhängigkeiten in den Manifesten (db -> core -> Module)
ensure [tacov]
